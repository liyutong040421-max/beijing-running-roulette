# Beijing Running Roulette — environment variables

# 高德 Web JS API key. Created at https://lbs.amap.com/ → 应用管理 → 添加 Key
# Service type: "Web端(JS API)". Add localhost,127.0.0.1 to the referer
# whitelist for local dev; add your *.vercel.app domain after first deploy.
NEXT_PUBLIC_AMAP_KEY=

# (Stage B only) 高德 Web 服务 key — for server-side 路径规划 calls.
# Service type: "Web服务". Same 高德 application, different key.
# AMAP_SERVER_KEY=
