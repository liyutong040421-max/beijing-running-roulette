# Beijing Running Roulette — environment variables

# 高德 Web JS API key. Stage C only: browser-side AMap JS map.
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=

# 高德 Web 服务 key: server-side walking route planning and POI search.
# Service type: "Web服务". Same 高德 application, different key.
AMAP_WEB_SERVICE_KEY=
